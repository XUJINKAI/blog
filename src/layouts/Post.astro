---
import Base from "./Base.astro";
import Toc from "../components/Toc.astro";
import { buildSeo } from "../lib/seo.js";
import { dateFormat, toISODate } from "../lib/dates.js";
import { extractTocItems, renderMarkdown } from "../lib/markdown.js";
import { site } from "../lib/site.js";

const { post } = Astro.props;
const seo = buildSeo({
  title: post.title,
  description: post.description,
  canonicalPath: post.cleanUrl,
  isPost: true,
  publishedDate: post.date,
  lastModified: post.lastModified,
});
const tocItems = extractTocItems(post.body, post.toc);
const content = renderMarkdown(post.body);
---
<Base seo={seo} keywords={post.keywords} publishedDate={post.date}
  comments={post.comments} identifier={post.cleanUrl}>
  <article class="post h-entry" itemscope itemtype="http://schema.org/BlogPosting">
    <header class="post-header">
      <h1 class="post-title p-name" itemprop="name headline">{post.title}</h1>
    </header>
    <div class="post-meta">
      {post.lastModified && (
        <>
          <span>更新于 </span>
          <time class="dt-modified" datetime={toISODate(post.lastModified, site.timezone)} itemprop="dateModified">
            {dateFormat(post.lastModified, site.timezone)}
          </time>
          <span>, </span>
        </>
      )}
      <span>创建于 </span>
      <time class="dt-published" datetime={toISODate(post.date, site.timezone)} itemprop="datePublished">
        {dateFormat(post.date, site.timezone)}
      </time>
    </div>
    <div class="post-meta">
      标签:
      {post.tags.map((tag) => (
        <a class="tag" href={"/posts/?tag=" + encodeURIComponent(tag)}>{tag}</a>
      ))}
    </div>
    <Toc items={tocItems} comments={post.comments} disqus={site.integrations.disqus} />
    <div class="post-content e-content" itemprop="articleBody" set:html={content}></div>
    <a class="u-url" href={seo.canonicalUrl} hidden></a>
  </article>
</Base>

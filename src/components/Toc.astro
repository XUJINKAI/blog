---
const { items = [], comments = false, disqus = false } = Astro.props;

function renderList(items) {
  if (!items.length) return "";
  const minLevel = Math.min(...items.map((item) => item.level));
  let previous = 0;
  let html = '<ul id="toc" class="section-nav">';

  for (const item of items) {
    const link = '<a href="#' + item.id + '">' + item.text + '</a>';
    if (previous === 0) {
      html += '<li class="toc-entry toc-h' + item.level + '">' + link;
    } else if (item.level > previous) {
      html += '<ul><li class="toc-entry toc-h' + item.level + '">' + link;
    } else if (item.level === previous) {
      html += '</li><li class="toc-entry toc-h' + item.level + '">' + link;
    } else {
      for (let level = previous; level > item.level; level -= 1) html += '</li></ul>';
      html += '</li><li class="toc-entry toc-h' + item.level + '">' + link;
    }
    previous = item.level;
  }

  for (let level = previous; level >= minLevel; level -= 1) {
    html += '</li>';
    if (level > minLevel) html += '</ul>';
  }
  return html + '</ul>';
}
---
{items.length > 0 && (
  <>
    <div class="post-toc" id="tocPanel">
      <button class="toc-close" type="button" aria-label="收起目录">×</button>
      <Fragment set:html={renderList(items)} />
      <nav class="toc-actions" aria-label="页面导航">
        <a class="toc-action" href="#page-top">回到顶部</a>
        {comments && disqus && <a class="toc-action" href="#comments">前往评论</a>}
      </nav>
    </div>
    <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="tocPanel">目录</button>
    <script is:inline>
      (function () {
        var toggle = document.querySelector(".toc-toggle");
        var close = document.querySelector(".toc-close");
        var panel = document.getElementById("tocPanel");
        if (!panel) return;

        var moved = false;
        var isMobile = window.matchMedia("(max-width: 1200px)");

        function setOpen(open) {
          panel.classList.toggle("toc-open", open);
          panel.classList.toggle("toc-collapsed", !open);
          if (toggle) toggle.setAttribute("aria-expanded", open ? "true" : "false");
        }

        if (toggle) toggle.addEventListener("click", function (e) {
          if (moved) { e.preventDefault(); e.stopPropagation(); return; }
          setOpen(!panel.classList.contains("toc-open"));
        });
        if (close) close.addEventListener("click", function () { setOpen(false); });

        panel.querySelectorAll('a[href^="#"]').forEach(function (link) {
          link.addEventListener("click", function (e) {
            var targetId = decodeURIComponent(link.hash.slice(1));
            var target = document.getElementById(targetId);
            if (!target) return;
            e.preventDefault();
            history.replaceState(null, "", link.hash);
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          });
        });

        if (isMobile.matches) {
          document.addEventListener("click", function (e) {
            if (!panel.classList.contains("toc-open")) return;
            if (panel.contains(e.target) || (toggle && toggle.contains(e.target))) return;
            setOpen(false);
          });
        }

        if (toggle) {
          var dragging = false, offX = 0, offY = 0, startX = 0, startY = 0;
          toggle.addEventListener("pointerdown", function (e) {
            if (e.pointerType === "mouse" && e.button !== 0) return;
            dragging = true; moved = false; startX = e.clientX; startY = e.clientY;
            var r = toggle.getBoundingClientRect();
            offX = e.clientX - r.left; offY = e.clientY - r.top;
            toggle.setPointerCapture(e.pointerId);
          });
          toggle.addEventListener("pointermove", function (e) {
            if (!dragging) return;
            if (!moved && Math.abs(e.clientX - startX) < 6 && Math.abs(e.clientY - startY) < 6) return;
            moved = true;
            var x = Math.max(8, Math.min(window.innerWidth - toggle.offsetWidth - 8, e.clientX - offX));
            var y = Math.max(8, Math.min(window.innerHeight - toggle.offsetHeight - 8, e.clientY - offY));
            toggle.style.left = x + "px"; toggle.style.top = y + "px";
            toggle.style.right = "auto"; toggle.style.bottom = "auto";
          });
          function stopDrag() { dragging = false; }
          toggle.addEventListener("pointerup", stopDrag);
          toggle.addEventListener("pointercancel", stopDrag);
        }
      })();
    </script>
  </>
)}

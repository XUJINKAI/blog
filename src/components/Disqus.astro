---
import { site } from "../lib/site.js";

const { canonicalUrl, identifier } = Astro.props;
const embedUrl = "https://" + site.integrations.disqus + ".disqus.com/embed.js";
const scriptBody = [
  "window.disqus_config = function () {",
  "  this.page.url = " + JSON.stringify(canonicalUrl) + ";",
  "  this.page.identifier = " + JSON.stringify(identifier) + ";",
  "};",
  "(function () {",
  "  var d = document, s = d.createElement('script');",
  "  s.src = " + JSON.stringify(embedUrl) + ";",
  "  s.setAttribute('data-timestamp', +new Date());",
  "  (d.head || d.body).appendChild(s);",
  "})();",
].join("\n");
---
<div id="disqus_thread"><i>Disqus评论加载中...</i></div>
<script is:inline set:html={scriptBody}></script>
<noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by
    Disqus.</a></noscript>

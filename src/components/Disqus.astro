---
import { site } from "../lib/site.js";

const { canonicalUrl } = Astro.props;
const identifier = new URL(canonicalUrl).pathname;
const embedUrl = "https://" + site.integrations.disqus + ".disqus.com/embed.js";
---
<div
  id="disqus_thread"
  data-url={canonicalUrl}
  data-identifier={identifier}
><i>Disqus评论加载中...</i></div>
<script is:inline>
  window.disqus_config = function () {
    var root = document.getElementById("disqus_thread");
    this.page.url = root.dataset.url;
    this.page.identifier = root.dataset.identifier;
  };
</script>
<script is:inline async src={embedUrl}></script>
<noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by
    Disqus.</a></noscript>

---
layout: layouts/base.njk
permalink: /
title:
wide: true
codeHighlight: false
---

<div class="personal-home">
    <section class="home-projects">
        <div class="project-list">
            {% for project in homeProjects %}
            <article class="project-card{% if project.variant == "intro" %} home-intro-card{% endif %}"
                data-project-width="{{ project.width }}">
                <div class="project-copy home-markdown">
                    {% set projectContent %}{% include project.file %}{% endset %}
                    {{ projectContent | markdownFragment | safe }}
                </div>
            </article>
            {% endfor %}
        </div>
    </section>

    <section class="home-section home-writing">
        <a class="home-writing-heading" href="/posts/">
            <h2>最近博文</h2>
            <span>全部博文 →</span>
        </a>

        <ol class="home-writing-list">
            {% for post in collections.homePosts %}
            {% set activityDate = post.data.last_modified_at or post.date %}
            <li>
                <a href="{{ post.data.cleanUrl or post.url }}">
                    <time datetime="{{ activityDate | toISODate }}">{{ activityDate | dateFormat }}</time>
                    <span>{{ post.data.title }}</span>
                </a>
            </li>
            {% endfor %}
        </ol>
    </section>

    <section class="home-section home-contact home-markdown">
        {% set contact %}{% include "home/contact.md" %}{% endset %}
        {{ contact | markdownFragment | safe }}
    </section>
</div>

<script src="/assets/js/home-projects.js" defer></script>

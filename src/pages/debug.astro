---
import { isDebug, site } from "../lib/site.js";
import { getPublishedPosts } from "../lib/posts.js";
const posts = await getPublishedPosts();
---
{isDebug ? (
  <html lang={site.locale}>
    <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Debug Variables</title></head>
    <body>
      <p style="float: right; font-size: 0.8em;"><a href="/">[返回首页]</a></p>
      <h1>Debug Environment</h1><p>仅在开发模式显示此页面。</p>
      <pre>{JSON.stringify(posts, null, 2)}</pre>
    </body>
  </html>
) : (
  <html><head><meta http-equiv="refresh" content="0; url=/404.html" /></head>
  <body><p>Debug mode is disabled. Redirecting to 404...</p></body></html>
)}

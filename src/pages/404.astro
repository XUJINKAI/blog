---
import Base from "../layouts/Base.astro";
import { buildSeo } from "../lib/seo.js";
const seo = buildSeo({ canonicalPath: "/404" });
---
<Base seo={seo}>
  <style type="text/css" media="screen" is:inline>
    .container { margin: 10px auto; max-width: 600px; text-align: center; }
    h1 { margin: 30px 0; font-size: 4em; line-height: 1; letter-spacing: -1px; }
  </style>
  <div class="container">
    <h1>404</h1>
    <p><strong>Page not found :(</strong></p>
    <p>The requested page could not be found.</p>
  </div>
</Base>

---
import Base from "../../layouts/Base.astro";
import { getPostsByDate } from "../../lib/posts.js";
import { buildSeo } from "../../lib/seo.js";
import { dateFormat, toISODate } from "../../lib/dates.js";
import { isDebug, site } from "../../lib/site.js";
const posts = await getPostsByDate();
const seo = buildSeo({ title: "文章", canonicalPath: "/posts/" });
---
<Base seo={seo}>
  <div class="posts-page">
    {isDebug && <p style="float: right; font-size: 0.8em;"><a href="/debug">[调试页面]</a></p>}
    <div class="post-selector-panel">
      <div class="post-sort-panel">
        <span class="post-panel-tip">排序: </span>
        <a href="javascript:toggleSort('update')" class="post-sort-button" data-sort="update">更新时间<span class="post-sort-sign"></span></a>
        <a href="javascript:toggleSort('date')" class="post-sort-button" data-sort="date">创建时间<span class="post-sort-sign"></span></a>
        <span class="post-panel-tip">筛选: </span>
        <a href="javascript:toggleEmoji()" class="post-filter-emoji">emoji</a>
      </div>
      <div class="post-filter-panel">
        <span class="post-panel-tip">标签: </span><div class="tags-list"></div>
      </div>
    </div>
    {posts.length > 0 && (
      <ul class="post-list">
        {posts.map((post) => (
          <li date={toISODate(post.date, site.timezone)}
            update={post.lastModified ? toISODate(post.lastModified, site.timezone) : undefined}>
            <a href={post.cleanUrl}>
              <h3>{post.title}{post.emotag && <emotag>{post.emotag}</emotag>}</h3>
              {site.appearance.show_excerpts && <excerpt>{post.excerpt}</excerpt>}
            </a>
            <pmeta>
              <date>{dateFormat(post.displayDate, site.timezone)}</date>
              <tags>{post.tags.map((tag) => <tag>{tag}</tag>)}</tags>
            </pmeta>
          </li>
        ))}
      </ul>
    )}
  </div>
  <script is:inline define:vars={{ disqus: site.integrations.disqus }}>var SITE_CONFIG = { disqus: disqus };</script>
  <script is:inline src="/assets/js/posts.js" async></script>
</Base>
